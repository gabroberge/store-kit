{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": false,
		"noEmit": true,
		"rootDir": "."
	},
	"include": [
		"apps/*/src/**/*.ts",
		"apps/*/tsdown.config.ts",
		"apps/*/vitest.config.ts",
		"packages/*/src/**/*.ts",
		"packages/*/tsdown.config.ts",
		"packages/*/vitest.config.ts",
		"sheriff.config.ts",
		"vitest.config.ts"
	]
}
